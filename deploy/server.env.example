NODE_ENV=production
PORT=4318
HOME=/var/lib/tongzhou-ai
PATH=/opt/tongzhou-runtime/node/bin:/usr/local/bin:/usr/bin:/bin
TONGZHOU_DATA_DIR=/var/lib/tongzhou-ai
TONGZHOU_DEPLOYMENT=server
# Empty for SSH-only loopback access; see ACCEPTANCE.md for the current deployment.
# HTTPS mode: set to https://YOUR_DOMAIN only after a trusted HTTPS ingress works.
TONGZHOU_PUBLIC_ORIGIN=
# Direct high-port HTTP internal testing (off by default):
# TONGZHOU_PUBLIC_ORIGIN=http://YOUR_IP:18082
TONGZHOU_ALLOW_HTTP_INTERNAL_TEST=0
# Exact approved IPv4/IPv6 addresses, comma separated; no wildcard/CIDR.
# Match nginx and the cloud security group. Loopback is for server-side QA only.
TONGZHOU_HTTP_TEST_ALLOWED_IPS=127.0.0.1
# Generate separately; never commit actual values. Hash: salt(32hex):scrypt(128hex).
TONGZHOU_PASSWORD_HASH=REPLACE_WITH_SCRYPT_HASH
TONGZHOU_AUTH_SECRET=REPLACE_WITH_64_HEX_RANDOM_BYTES
TONGZHOU_DWG_BIN=/opt/tongzhou-runtime/libredwg/bin/dwg2dxf
TONGZHOU_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
HTTP_PROXY=http://127.0.0.1:17890
HTTPS_PROXY=http://127.0.0.1:17890
ALL_PROXY=http://127.0.0.1:17890
NO_PROXY=localhost,127.0.0.1,::1
NODE_USE_ENV_PROXY=1
