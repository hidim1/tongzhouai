{
  "name": "tongzhou-ai",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs --dev",
    "start": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "seed": "node scripts/seed.mjs",
    "desktop": "electron .",
    "desktop:prepare:mac": "node desktop/prepare-runtime.mjs mac-arm64",
    "desktop:prepare:win": "node desktop/prepare-runtime.mjs win-x64",
    "package:mac": "npm run build && npm run desktop:prepare:mac && electron-builder --config desktop/electron-builder.yml --mac --arm64",
    "package:win": "npm run build && npm run desktop:prepare:win && electron-builder --config desktop/electron-builder.yml --win --x64"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "cheerio": "^1.2.0",
    "docx": "^9.8.1",
    "dxf-parser": "^1.1.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "lucide-react": "^1.52.0",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "unpdf": "^1.8.1",
    "word-extractor": "^1.0.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@openai/codex": "^0.160.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  },
  "main": "desktop/main.cjs",
  "description": "舟知 · Codex 驱动的工程投标工作台",
  "author": "舟知",
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
