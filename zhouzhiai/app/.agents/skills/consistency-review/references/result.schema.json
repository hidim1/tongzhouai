{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "maxLength": 18000
    },
    "requirements": {
      "maxItems": 150,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 18000
          },
          "category": {
            "type": "string",
            "maxLength": 18000
          },
          "content": {
            "type": "string",
            "maxLength": 18000
          },
          "expected": {
            "type": "string",
            "maxLength": 18000
          },
          "status": {
            "type": "string",
            "maxLength": 18000
          },
          "response": {
            "type": "string",
            "maxLength": 18000
          },
          "source": {
            "type": "string",
            "maxLength": 18000
          },
          "fileId": {
            "type": "string",
            "maxLength": 18000
          }
        },
        "required": [
          "id",
          "category",
          "content",
          "expected",
          "status",
          "response",
          "source",
          "fileId"
        ],
        "additionalProperties": false
      }
    },
    "materials": {
      "maxItems": 150,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 18000
          },
          "name": {
            "type": "string",
            "maxLength": 18000,
            "description": "设备或物料名称，例如手动球阀、离心泵；不是材质。"
          },
          "spec": {
            "type": "string",
            "maxLength": 18000,
            "description": "原文明确给出的型号、规格或额定参数，例如 DN25；未知为空字符串。"
          },
          "material": {
            "type": "string",
            "maxLength": 18000,
            "description": "材质或材料牌号，例如 316L、304、PTFE；不是设备或物料名称。只采用原文明确的材质，未知为空字符串。"
          },
          "unit": {
            "type": "string",
            "maxLength": 18000
          },
          "brand": {
            "type": "string",
            "maxLength": 18000
          },
          "quantity": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ],
            "description": "原文明确的数量；未提供则 null，不能根据出现次数推断。"
          },
          "tag": {
            "type": "string",
            "maxLength": 18000,
            "description": "原始工艺位号，例如 V-101；未提供为空字符串。"
          },
          "price": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ],
            "description": "有有效报价来源的单价；未提供则 null，不能填 0 或估价。"
          },
          "status": {
            "type": "string",
            "maxLength": 18000
          },
          "source": {
            "type": "string",
            "maxLength": 18000
          },
          "fileId": {
            "type": "string",
            "maxLength": 18000
          },
          "note": {
            "type": "string",
            "maxLength": 18000
          }
        },
        "required": [
          "id",
          "name",
          "spec",
          "material",
          "unit",
          "brand",
          "quantity",
          "tag",
          "price",
          "status",
          "source",
          "fileId",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "issues": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 18000
          },
          "title": {
            "type": "string",
            "maxLength": 18000
          },
          "detail": {
            "type": "string",
            "maxLength": 18000
          },
          "severity": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "status": {
            "type": "string",
            "maxLength": 18000
          },
          "source": {
            "type": "string",
            "maxLength": 18000
          },
          "note": {
            "type": "string",
            "maxLength": 18000
          }
        },
        "required": [
          "id",
          "title",
          "detail",
          "severity",
          "status",
          "source",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "sections": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 18000
          },
          "title": {
            "type": "string",
            "maxLength": 18000
          },
          "content": {
            "type": "string",
            "maxLength": 18000
          }
        },
        "required": [
          "id",
          "title",
          "content"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "summary",
    "requirements",
    "materials",
    "issues",
    "sections"
  ],
  "additionalProperties": false
}
